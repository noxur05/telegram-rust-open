# Required
TELEGRAM_BOT_API=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_bot

# Marzban VPN Panel
MARZBAN_HOST=https://your-marzban-panel.com
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=admin_password

# NOWPayments
NOWPAYMENTS_API_KEY=your_api_key

# Optional - Payment settings (defaults shown)
# PRICE_CURRENCY=USD
# PAY_CURRENCY=USDTBSC
# DESCRIPTION=VPN subscription top-up

# Optional - Admin & Support
# ADMIN_TELEGRAM_ID=123456789
# SUPPORT_CHAT_ID=-1001234567890

# Optional - route Telegram API traffic through a SOCKS5/HTTP proxy
# TELOXIDE_PROXY=socks5://127.0.0.1:2080

# NOTE: subscription price/duration/data-limit are NOT env-configurable.
# They live in the `subscriptions` table and are managed via /admin → Subscriptions.
# Inbounds and proxy types are read live from Marzban's /api/inbounds.
